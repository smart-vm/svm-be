<%
  input = "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm"
  label = "block text-sm font-medium text-gray-700 mb-2"
%>
<%= form_with(model: advertisement, class: "space-y-6") do |f| %>
  <% if advertisement.errors.any? %>
    <div class="bg-red-50 text-red-600 p-4 rounded-lg text-sm">
      <ul class="list-disc pl-5">
        <% advertisement.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Title (internal)", class: label %>
    <%= f.text_field :title, class: input, placeholder: "e.g. Fresh Lime Soda — October" %>
  </div>

  <div>
    <%= f.label :media, "Image or video", class: label %>
    <% if advertisement.media.attached? && advertisement.persisted? %>
      <div class="mb-3 w-48 aspect-[4/3] bg-gray-900 rounded-lg overflow-hidden">
        <% if advertisement.video? %>
          <video src="<%= url_for(advertisement.media) %>" class="w-full h-full object-contain" muted></video>
        <% else %>
          <%= image_tag advertisement.media, class: "w-full h-full object-contain" %>
        <% end %>
      </div>
    <% end %>
    <%= f.file_field :media, accept: "image/png,image/jpeg,image/webp,video/mp4",
          class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
    <p class="text-xs text-gray-500 mt-2">
      PNG, JPG, WebP or MP4 (no sound is played), up to 50 MB. Recommended sizes: side column 1200×1700 (portrait),
      idle screen 1920×1080, dispensing 1280×720. Other shapes are shown whole on a blurred backdrop.
      Check local advertising rules before running tobacco ads.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div>
      <%= f.label :duration_seconds, "Seconds on screen", class: label %>
      <%= f.number_field :duration_seconds, min: 3, max: 60, class: input %>
      <p class="text-xs text-gray-500 mt-1">Images only; videos play to the end.</p>
    </div>
    <div>
      <%= f.label :starts_at, "Start (optional)", class: label %>
      <%= f.datetime_field :starts_at, class: input %>
    </div>
    <div>
      <%= f.label :ends_at, "End (optional)", class: label %>
      <%= f.datetime_field :ends_at, class: input %>
    </div>
  </div>

  <div>
    <span class="<%= label %>">Show on</span>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <% Advertisement::PLACEMENTS.each do |key, description| %>
        <label class="flex items-start gap-3 p-3 rounded-lg border border-gray-200 cursor-pointer hover:bg-gray-50">
          <%= check_box_tag "advertisement[placements][]", key, advertisement.placements.include?(key), class: "mt-0.5", id: "placement_#{key}" %>
          <span class="text-sm"><span class="font-medium text-gray-900"><%= key.humanize %></span><br><span class="text-xs text-gray-500"><%= description %></span></span>
        </label>
      <% end %>
    </div>
    <%= hidden_field_tag "advertisement[placements][]", "" %>
  </div>

  <div>
    <span class="<%= label %>">Machines</span>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
      <%= f.collection_check_boxes :machine_ids, Machine.order(:location_name), :id, :location_name do |b| %>
        <label class="flex items-center gap-3 p-2.5 rounded-lg border border-gray-200 cursor-pointer hover:bg-gray-50 text-sm">
          <%= b.check_box %> <%= b.text %>
        </label>
      <% end %>
    </div>
    <p class="text-xs text-gray-500 mt-2">Leave all unticked to show it on every machine.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <%= f.label :position, "Order (lower shows first)", class: label %>
      <%= f.number_field :position, class: input %>
    </div>
    <div class="flex items-end">
      <label class="flex items-center gap-3 text-sm text-gray-700 pb-3">
        <%= f.check_box :active %> Active (untick to pause without deleting)
      </label>
    </div>
  </div>

  <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
    <a href="<%= advertisements_path %>" data-turbo="false" class="px-5 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50 rounded-lg transition-colors">Cancel</a>
    <%= f.submit "Save Advertisement", class: "px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg cursor-pointer transition-colors shadow-sm" %>
  </div>
<% end %>
