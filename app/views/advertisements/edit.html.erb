<div class="flex h-screen bg-[#f8f9fa] font-sans text-gray-800">
  <%= render "sidebar" %>

  <main class="flex-1 flex flex-col overflow-y-auto">
    <header class="h-24 flex items-center justify-between px-8 bg-[#f8f9fa]">
      <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
          <a href="<%= advertisements_path %>" data-turbo="false" class="hover:text-blue-600 transition-colors">Advertisements</a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Edit</span>
        </div>
        <h1 class="text-xl font-bold text-gray-900">Edit Advertisement</h1>
      </div>
    </header>

    <div class="px-8 pb-8 max-w-4xl">
      <div class="bg-white rounded-2xl p-8 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
        <%= render "form", advertisement: @advertisement %>
      </div>
    </div>
  </main>
</div>
