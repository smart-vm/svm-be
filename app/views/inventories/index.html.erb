<div class="flex h-screen bg-[#f8f9fa] font-sans text-gray-800">
  
  <aside class="w-64 bg-white border-r border-gray-100 flex flex-col hidden md:flex">
    <div class="h-24 flex items-center justify-center flex-col pt-4">
      <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-600 to-red-500 mb-2"></div>
      <span class="text-sm font-bold text-blue-600">Traveloka Kiosk</span>
      <span class="text-[10px] text-gray-400">ERP System</span>
    </div>
    
    <nav class="flex-1 px-4 mt-8 space-y-1">
      <a href="<%= root_path %>" data-turbo="false" class="flex items-center gap-3 px-4 py-3 text-gray-500 hover:bg-gray-50 rounded-lg font-medium text-sm transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
        Dashboard
      </a>
      
      <a href="<%= machines_path %>" data-turbo="false" class="flex items-center gap-3 px-4 py-3 text-gray-500 hover:bg-gray-50 rounded-lg font-medium text-sm transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        Machines
      </a>
      
      <a href="<%= inventories_path %>" data-turbo="false" class="flex items-center gap-3 px-4 py-3 bg-blue-50 text-blue-600 rounded-lg font-medium text-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        Inventory
      </a>

      <a href="<%= transactions_path %>" class="flex items-center gap-3 px-4 py-3 text-gray-500 hover:bg-gray-50 rounded-lg font-medium text-sm transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
        Transactions
      </a>
    </nav>
  </aside>

  <main class="flex-1 flex flex-col overflow-y-auto">
    
    <header class="h-24 flex items-center justify-between px-8 bg-[#f8f9fa]">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Inventory Catalog</h1>
        <p class="text-xs text-gray-500 mt-1">Global product registry and current stock levels.</p>
      </div>
    </header>

    <div class="px-8 pb-8">
      <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-lg font-bold text-gray-900">Master Product List</h2>
          <a href="<%= new_inventory_path %>" data-turbo="false" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
            + Add New Product
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="text-xs font-semibold text-gray-500 border-b border-gray-100 bg-gray-50/50">
                <th class="py-4 px-4 rounded-tl-lg">Product Name</th>
                <th class="py-4 px-4">Price (Rp)</th>
                <th class="py-4 px-4 text-center">Global Stock</th>
                <th class="py-4 px-4">Active Deployments</th>
                <th class="py-4 px-4">Status</th>
                <th class="py-4 px-4 text-right rounded-tr-lg">Action</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              <% @products.each do |product| %>
                <% total_stock = product.slots.sum(:current_stock).to_i %>
                <% active_machines = product.slots.map(&:machine_id).uniq.size %>
                
                <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                  <td class="py-4 px-4">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded bg-gray-100 border border-gray-200 flex items-center justify-center overflow-hidden">
                        <% if product.image_url.present? %>
                          <img src="<%= product.image_url %>" alt="<%= product.name %>" class="w-full h-full object-cover">
                        <% else %>
                          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <% end %>
                      </div>
                      <span class="font-medium text-gray-900"><%= product.name %></span>
                    </div>
                  </td>
                  
                  <td class="py-4 px-4 font-mono text-xs text-gray-500"><%= number_with_delimiter(product.price.to_i, delimiter: '.') %></td>
                  
                  <td class="py-4 px-4 text-center">
                    <span class="font-bold <%= total_stock < 10 ? 'text-red-500' : 'text-gray-700' %>"><%= total_stock %></span>
                  </td>
                  
                  <td class="py-4 px-4 text-gray-500 text-xs">
                    <div class="relative inline-flex items-center gap-1.5 group cursor-help">
                      <span>In <%= active_machines %> <%= 'machine'.pluralize(active_machines) %></span>
                      
                      <% if active_machines > 0 %>
                        <svg class="w-4 h-4 text-gray-400 group-hover:text-blue-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-3 bg-gray-900 text-white text-xs rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 transform scale-95 group-hover:scale-100">
                          <div class="font-bold text-gray-100 mb-2 border-b border-gray-700 pb-2">Stock per Location</div>
                          <ul class="space-y-1.5">
                            <% product.slots.includes(:machine).group_by(&:machine).each do |machine, slots| %>
                              <% machine_stock = slots.sum(&:current_stock).to_i %>
                              <li class="flex justify-between items-center">
                                <span class="truncate max-w-[160px] font-medium text-gray-300"><%= machine.location_name %></span>
                                <span class="text-blue-400 font-bold font-mono"><%= machine_stock %> pcs</span>
                              </li>
                            <% end %>
                          </ul>
                          <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900"></div>
                        </div>
                      <% end %>
                    </div>
                  </td>
                  
                  <td class="py-4 px-4">
                    <% if total_stock > 10 %>
                      <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-green-50 text-green-600">
                        Healthy
                      </span>
                    <% elsif total_stock > 0 %>
                      <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-orange-50 text-orange-600">
                        Low Stock
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-red-50 text-red-600">
                        Out of Stock
                      </span>
                    <% end %>
                  </td>
                  
                  <td class="py-4 px-4 text-right">
                    <div class="flex items-center justify-end">
                      <a href="<%= edit_inventory_path(product) %>" data-turbo="false" title="Edit Product Catalog" class="text-amber-600 hover:text-amber-800 bg-amber-50 hover:bg-amber-100 p-2 rounded-lg transition-colors flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                      </a>
                    </div>
                  </td>
                  
                </tr>
              <% end %>
              <% if @products.empty? %>
                <tr>
                  <td colspan="6" class="py-8 text-center text-gray-400 text-sm">No products in the catalog yet.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>