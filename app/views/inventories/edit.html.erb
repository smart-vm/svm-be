<div class="flex h-screen bg-[#f8f9fa] font-sans text-gray-800">
  
  <!-- Sidebar -->
  <%= render "shared/sidebar" %>

  <!-- Main Content Area -->
  <main id="main-content" tabindex="-1" class="flex-1 min-w-0 flex flex-col overflow-y-auto">
    <header class="h-24 flex items-center justify-between px-8 bg-[#f8f9fa]">
      <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
          <a href="<%= inventories_path %>" data-turbo="false" class="hover:text-blue-600 transition-colors">Inventory</a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Edit</span>
        </div>
        <h1 class="text-xl font-bold text-gray-900">Edit <%= @product.name %></h1>
      </div>
    </header>

    <div class="px-8 pb-8 max-w-3xl">
      <div class="bg-white rounded-2xl p-8 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
        
        <!-- Note the explicit url: inventory_path(@product) -->
        <%= form_with(model: @product, url: inventory_path(@product), class: "space-y-6") do |f| %>
          <% if @product.errors.any? %>
            <div class="bg-red-50 text-red-600 p-4 rounded-lg text-sm mb-6">
              <ul class="list-disc pl-5">
                <% @product.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="col-span-1">
              <%= f.label :name, "Product Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.text_field :name, required: true, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm" %>
            </div>
            
            <div class="col-span-1">
              <%= f.label :price, "Price (Rp)", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.number_field :price, min: "0.01", step: "0.01", required: true, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm" %>
            </div>
          </div>

          <div>
            <%= f.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.text_area :description, rows: 3, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm" %>
          </div>

          <div>
            <%= f.label :image, "Product Image", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <% if @product.image.attached? %>
              <%= image_tag @product.image, class: "w-24 h-24 object-cover rounded-lg border border-gray-200 mb-3" %>
            <% end %>
            <%= f.file_field :image, accept: "image/*", class: "w-full px-3 py-2 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
          </div>

          <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
            <a href="<%= inventories_path %>" data-turbo="false" class="px-5 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50 rounded-lg transition-colors">Cancel</a>
            <%= f.submit "Update Product", class: "px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg cursor-pointer transition-colors shadow-sm" %>
          </div>
        <% end %>

      </div>
    </div>
  </main>
</div>