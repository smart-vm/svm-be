<div class="flex h-screen bg-[#f8f9fa] font-sans text-gray-800">
  
  <!-- Sidebar -->
  <%= render "shared/sidebar" %>

  <!-- Main Content Area -->
  <main id="main-content" tabindex="-1" class="flex-1 min-w-0 flex flex-col overflow-y-auto">
    
    <header class="h-24 flex items-center justify-between px-8 bg-[#f8f9fa]">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Transaction Ledger</h1>
        <p class="text-xs text-gray-500 mt-1">Review payments, product deliveries, and transactions needing attention. Reload to see updates.</p>
      </div>
    </header>

    <div class="px-8 pb-8">
      <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-lg font-bold text-gray-900">Recent Activity</h2>
          <a href="<%= transactions_path(format: :csv, q: @query, status: @status, page: @page) %>" data-turbo="false" class="bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            Export this page (CSV)
          </a>
        </div>

        <%= form_with url: transactions_path, method: :get, class: "erp-toolbar" do |form| %>
          <div>
            <%= form.label :q, "Search ID, location, or product" %>
            <%= form.search_field :q, value: @query, placeholder: "e.g. station or transaction ID", maxlength: 100 %>
          </div>
          <div>
            <%= form.label :status, "Transaction status" %>
            <%= form.select :status, Transaction::STATUSES.map { |status| [status.humanize, status] }, { include_blank: "All statuses", selected: @status } %>
          </div>
          <%= form.submit "Apply filters", class: "erp-action" %>
          <%= link_to "Clear filters", transactions_path, class: "text-sm underline" if @query.present? || @status.present? %>
        <% end %>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="text-xs font-semibold text-gray-500 border-b border-gray-100 bg-gray-50/50">
                <th scope="col" class="py-4 px-4 rounded-tl-lg">Date & Time</th>
                <th scope="col" class="py-4 px-4">Transaction ID</th>
                <th scope="col" class="py-4 px-4">Location</th>
                <th scope="col" class="py-4 px-4">Product</th>
                <th scope="col" class="py-4 px-4">Amount</th>
                <th scope="col" class="py-4 px-4">Status</th>
                <th scope="col" class="py-4 px-4 text-right rounded-tr-lg">Action</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              <% @transactions.each do |tx| %>
                <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                  <td class="py-4 px-4 text-gray-500 whitespace-nowrap">
                    <%= tx.created_at.strftime("%d %b %Y, %H:%M") %>
                  </td>
                  <td class="py-4 px-4 font-mono text-xs text-gray-500">
                    <%= tx.uuid.split('-').first %>
                  </td>
                  <td class="py-4 px-4 text-gray-900">
                    <%= tx.machine.location_name %>
                  </td>
                  <td class="py-4 px-4 font-medium text-gray-900">
                    <%= tx.slot&.product&.name || 'Unknown Product' %>
                  </td>
                  <td class="py-4 px-4 font-mono text-gray-700">
                    Rp <%= number_with_delimiter(tx.amount.to_i, delimiter: '.') %>
                  </td>
                  <td class="py-4 px-4">
                    <%= render "status_badge", tx: tx %>
                    <% if tx.failure_reason.present? %>
                      <span class="block mt-1 text-[11px] text-gray-400"><%= tx.failure_reason.humanize %></span>
                    <% end %>
                  </td>
                  <td class="py-4 px-4 text-right">
                    <% if tx.resolvable? %>
                      <div class="flex justify-end gap-2">
                        <%= button_to "Mark refunded", resolve_transaction_path(tx, outcome: "refunded"), method: :patch,
                              form: { data: { turbo_confirm: "Confirm the customer was refunded Rp #{number_with_delimiter(tx.amount.to_i, delimiter: '.')}?" } },
                              class: "text-red-600 hover:text-red-800 text-xs font-medium" %>
                        <% if tx.needs_review? %>
                          <%= button_to "Mark dispensed", resolve_transaction_path(tx, outcome: "settled"), method: :patch,
                                form: { data: { turbo_confirm: "Confirm the product actually dropped?" } },
                                class: "text-green-600 hover:text-green-800 text-xs font-medium" %>
                        <% end %>
                      </div>
                    <% else %>
                      <details>
                        <summary class="text-teal-700 cursor-pointer text-sm font-medium">Details</summary>
                        <dl class="mt-2 text-xs text-gray-600 break-all">
                          <dt class="font-semibold">Full transaction ID</dt>
                          <dd class="select-all"><%= tx.uuid %></dd>
                          <dt class="font-semibold mt-2">Payment method</dt>
                          <dd><%= tx.payment_method&.humanize || 'Not recorded' %></dd>
                          <dt class="font-semibold mt-2">Reference</dt>
                          <dd class="select-all"><%= tx.external_reference.presence || 'Not recorded' %></dd>
                        </dl>
                      </details>
                    <% end %>
                  </td>
                </tr>
              <% end %>
              <% if @transactions.empty? %>
                <tr>
                  <td colspan="7" class="py-8 text-center text-gray-500 text-sm"><%= @query.present? || @status.present? ? 'No transactions match these filters. Try clearing them.' : 'No transactions recorded yet.' %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <nav aria-label="Transaction pages" class="erp-pagination">
          <p><%= @total_count.zero? ? 'No results' : "Showing #{(@page - 1) * TransactionsController::PAGE_SIZE + 1}–#{[ @page * TransactionsController::PAGE_SIZE, @total_count ].min} of #{@total_count}" %></p>
          <div>
            <%= link_to "Previous", transactions_path(q: @query, status: @status, page: @page - 1), rel: "prev" if @page > 1 %>
            <span>Page <%= @page %> of <%= @total_pages %></span>
            <%= link_to "Next", transactions_path(q: @query, status: @status, page: @page + 1), rel: "next" if @page < @total_pages %>
          </div>
        </nav>
      </div>
    </div>

  </main>
</div>
