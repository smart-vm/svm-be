<aside id="erp-sidebar" class="erp-sidebar" data-shell-target="sidebar">
  <div class="erp-sidebar-brand">
    <%= render "shared/brand" %>
    <button type="button" class="erp-icon-button erp-drawer-close" aria-label="Close navigation" data-action="shell#closeMobile">
      <%= erp_icon("close") %>
    </button>
  </div>
  <%= render "shared/navigation", label: "Main navigation" %>
  <button type="button" class="erp-collapse-button" data-action="shell#toggleSidebar" data-shell-target="toggle" aria-controls="erp-sidebar" aria-expanded="true" aria-label="Collapse sidebar">
    <%= erp_icon("collapse") %>
    <span class="erp-nav-label">Collapse</span>
  </button>
</aside>
