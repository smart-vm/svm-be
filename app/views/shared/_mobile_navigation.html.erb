<header class="erp-mobile-header">
  <%= link_to "Vendora", root_path, class: "erp-mobile-brand" %>
  <details class="erp-mobile-menu">
    <summary>Menu</summary>
    <div class="erp-mobile-menu-content">
      <%= render "shared/navigation", label: "Mobile navigation" %>
      <div class="erp-account">
        <p class="erp-account-email"><%= current_user.email %></p>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "erp-sign-out", data: { turbo: false } %>
      </div>
    </div>
  </details>
</header>
