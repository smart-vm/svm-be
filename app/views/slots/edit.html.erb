<div class="flex h-screen bg-[#f8f9fa] font-sans text-gray-800">
  
  <!-- Sidebar -->
  <%= render "shared/sidebar" %>

  <!-- Main Content Area -->
  <main id="main-content" tabindex="-1" class="flex-1 min-w-0 flex flex-col overflow-y-auto">
    <header class="h-24 flex items-center justify-between px-8 bg-[#f8f9fa]">
      <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
          <a href="<%= machines_path %>" data-turbo="false" class="hover:text-blue-600 transition-colors">Machines</a>
          <span>/</span>
          <a href="<%= machine_path(@slot.machine) %>" data-turbo="false" class="hover:text-blue-600 transition-colors"><%= @slot.machine.location_name %></a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Slot #<%= @slot.slot_number %></span>
        </div>
        <h1 class="text-xl font-bold text-gray-900">Manage Slot #<%= @slot.slot_number %></h1>
      </div>
    </header>

    <div class="px-8 pb-8 max-w-3xl">
      <div class="bg-white rounded-2xl p-8 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
        
        <%= form_with(model: @slot, class: "space-y-6") do |f| %>
          <% if @slot.errors.any? %>
            <div class="bg-red-50 text-red-600 p-4 rounded-lg text-sm mb-6">
              <ul class="list-disc pl-5">
                <% @slot.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <!-- Assign Product from Master Catalog -->
          <div class="p-5 bg-gray-50 rounded-xl border border-gray-100 mb-6">
            <h3 class="text-sm font-bold text-gray-900 mb-4">Product Assignment</h3>
            <%= f.label :product_id, "Mapped Product", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.collection_select :product_id, Product.order(:name), :id, :name, { include_blank: "Choose a product" }, required: true, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm bg-white" %>
            <p class="text-xs text-gray-400 mt-2">Select the product that is physically loaded into this spiral.</p>
          </div>

          <!-- Stock Configuration -->
          <p class="text-xs text-gray-500">Increasing stock creates a new timed batch for the added units. Reducing stock records an adjustment, not a sale. Existing units keep their original batch.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <%= f.label :current_stock, "Current Stock (pcs)", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.number_field :current_stock, min: 0, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm" %>
            </div>
            
            <div>
              <%= f.label :max_capacity, "Max Capacity (pcs)", class: "block text-sm font-medium text-gray-700 mb-2" %>
              <%= f.number_field :max_capacity, min: 1, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm" %>
            </div>
          </div>

          <!-- Hardware Status -->
          <div class="pt-2">
            <%= f.label :status, "Hardware Status", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :status, [['Operational', 'operational'], ['Jammed / Error', 'error'], ['Disabled', 'disabled']], {}, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm bg-white" %>
          </div>

          <!-- Actions -->
          <div class="pt-6 flex items-center justify-end gap-3 border-t border-gray-100">
            <a href="<%= machine_path(@slot.machine) %>" data-turbo="false" class="px-5 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50 rounded-lg transition-colors">Cancel</a>
            <%= f.submit "Update Slot Configuration", class: "px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg cursor-pointer transition-colors shadow-sm" %>
          </div>
        <% end %>

      </div>
    </div>
  </main>
</div>
