<div class="flex h-screen bg-[#f8f9fa] font-sans text-gray-800">
  
  <%= render "shared/sidebar" %>

  <main id="main-content" tabindex="-1" class="flex-1 min-w-0 flex flex-col overflow-y-auto">
    
    <header class="h-24 flex items-center justify-between px-8 bg-[#f8f9fa]">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Hardware Management</h1>
        <p class="text-xs text-gray-500 mt-1">Manage and monitor all physical vending machines.</p>
      </div>
    </header>

    <div class="px-8 pb-8">
      <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
       <div class="flex justify-between items-center mb-6">
        <h2 class="text-lg font-bold text-gray-900">Machine Directory</h2>
        <a href="<%= new_machine_path %>" data-turbo-frame="modal" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Add Machine
        </a>
      </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="text-xs font-semibold text-gray-500 border-b border-gray-100 bg-gray-50/50">
                <th scope="col" class="py-4 px-4 rounded-tl-lg">Machine UUID</th>
                <th scope="col" class="py-4 px-4">Location</th>
                <th scope="col" class="py-4 px-4 text-center">Total Slots</th>
                <th scope="col" class="py-4 px-4">Last Heartbeat</th>
                <th scope="col" class="py-4 px-4">Status</th>
                <th scope="col" class="py-4 px-4 text-right rounded-tr-lg">Action</th>
              </tr>
            </thead>
            <tbody class="text-sm">
              <% @machines.each do |machine| %>
                <tr class="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                  <td class="py-4 px-4 font-mono text-xs text-gray-500"><%= machine.uuid %></td>
                  <td class="py-4 px-4 font-medium text-gray-900"><%= machine.location_name %></td>
                  <td class="py-4 px-4 text-center text-gray-500"><%= machine.slots.size %></td>
                  <td class="py-4 px-4 text-gray-500">
                    <%= machine.last_heartbeat_at.present? ? time_ago_in_words(machine.last_heartbeat_at) + ' ago' : 'Never' %>
                  </td>
                  <td class="py-4 px-4">
                    <% if machine.status == 'active' %>
                      <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-green-50 text-green-600">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Active
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                        <span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span> <%= machine.status.capitalize %>
                      </span>
                    <% end %>
                  </td>
                  
                  <td class="py-4 px-4 text-right">
                    <div class="flex items-center justify-end gap-2">
                      <a href="<%= machine_path(machine) %>" data-turbo="false" title="Manage Layout" aria-label="Manage layout for machine <%= machine.uuid %>" class="text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 p-2 rounded-lg transition-colors flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                      </a>
                      
                      <a href="<%= edit_machine_path(machine) %>" data-turbo="false" title="Edit Machine Settings" aria-label="Edit settings for machine <%= machine.uuid %>" class="text-amber-600 hover:text-amber-800 bg-amber-50 hover:bg-amber-100 p-2 rounded-lg transition-colors flex items-center justify-center">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                      </a>
                    </div>
                  </td>
                  
                </tr>
              <% end %>
              <% if @machines.empty? %>
                <tr>
                  <td colspan="6" class="py-8 text-center text-gray-400 text-sm">No machines deployed yet.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </main>
</div>