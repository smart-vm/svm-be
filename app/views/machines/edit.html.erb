<div class="flex h-screen bg-[#f8f9fa] font-sans text-gray-800">
  
  <!-- Sidebar -->
  <%= render "shared/sidebar" %>

  <!-- Main Content Area -->
  <main id="main-content" tabindex="-1" class="flex-1 min-w-0 flex flex-col overflow-y-auto">
    <header class="h-24 flex items-center justify-between px-8 bg-[#f8f9fa]">
      <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
          <a href="<%= machines_path %>" data-turbo="false" class="hover:text-blue-600 transition-colors">Machines</a>
          <span>/</span>
          <span class="text-gray-900 font-medium">Edit</span>
        </div>
        <h1 class="text-xl font-bold text-gray-900">Edit Machine <%= @machine.uuid.split('-').first %></h1>
      </div>
    </header>

    <div class="px-8 pb-8 max-w-3xl">
      <div class="bg-white rounded-2xl p-8 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
        
        <%= form_with(model: @machine, class: "space-y-6") do |f| %>
          <% if @machine.errors.any? %>
            <div class="bg-red-50 text-red-600 p-4 rounded-lg text-sm mb-6">
              <ul class="list-disc pl-5">
                <% @machine.errors.full_messages.each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <%= f.label :location_name, "Location Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.text_field :location_name, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm" %>
          </div>

          <div>
            <%= f.label :status, "Operational Status", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.select :status, [['Active', 'active'], ['Maintenance', 'maintenance'], ['Inactive', 'inactive']], {}, class: "w-full px-4 py-3 rounded-lg border border-gray-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-200 outline-none transition-all text-sm bg-white" %>
          </div>

          <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
            <a href="<%= machines_path %>" data-turbo="false" class="px-5 py-2.5 text-sm font-medium text-gray-600 hover:bg-gray-50 rounded-lg transition-colors">Cancel</a>
            <%= f.submit "Update Machine", class: "px-5 py-2.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg cursor-pointer transition-colors shadow-sm" %>
          </div>
        <% end %>

      </div>
    </div>
  </main>
</div>