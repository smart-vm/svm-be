<div class="flex h-screen bg-[#f8f9fa] font-sans text-gray-800">
  
  <!-- Sidebar -->
  <%= render "shared/sidebar" %>

  <!-- Main Content Area -->
  <main id="main-content" tabindex="-1" class="flex-1 min-w-0 flex flex-col overflow-y-auto">
    
    <!-- Top Header -->
    <header class="h-24 flex items-center justify-between px-8 bg-[#f8f9fa]">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Operations overview</h1>
        <p class="text-xs text-gray-500 mt-1">Today is <%= Time.current.strftime("%A, %d %B %Y") %>.</p>
      </div>
      <p class="text-sm text-gray-600 break-all"><%= current_user.email %></p>
    </header>

    <!-- Dashboard Content -->
    <div class="px-8 pb-8">
      
      <!-- 4-Column Summary Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        
        <!-- Total Machines -->
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-3xl font-bold text-gray-900"><%= @total_machines %></h3>
            <div class="w-10 h-10 rounded-full bg-orange-50 flex items-center justify-center text-orange-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            </div>
          </div>
          <p class="text-sm font-medium text-gray-500 mb-2">Total Machines</p>
          <p class="text-xs text-green-500 flex items-center gap-1 font-medium">
            <%= pluralize(@new_machines_this_month, "new machine") %> this month
          </p>
        </div>

        <!-- Slot Sold -->
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-3xl font-bold text-gray-900"><%= @items_sold_today %></h3>
            <div class="w-10 h-10 rounded-full bg-blue-50 flex items-center justify-center text-blue-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            </div>
          </div>
          <p class="text-sm font-medium text-gray-500 mb-2">Items Sold Today</p>
          <p class="text-xs text-green-500 flex items-center gap-1 font-medium">
            Confirmed product deliveries today
          </p>
        </div>

        <!-- Revenue -->
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-2xl font-bold text-gray-900 truncate">Rp <%= number_with_delimiter(@today_revenue.to_i, delimiter: ".") %></h3>
            <div class="w-10 h-10 rounded-full bg-purple-50 flex items-center justify-center text-purple-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
          </div>
          <p class="text-sm font-medium text-gray-500 mb-2">Today's Revenue</p>
          <p class="text-xs text-green-500 flex items-center gap-1 font-medium">
            Settled transactions only
          </p>
        </div>

        <!-- Alerts -->
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
          <div class="flex justify-between items-start mb-4">
            <h3 class="text-3xl font-bold text-gray-900"><%= @low_stock_count %></h3>
            <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center text-red-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
          </div>
          <p class="text-sm font-medium text-gray-500 mb-2">Low Stock Alerts</p>
          <p class="text-xs <%= @low_stock_count > 0 ? 'text-red-500' : 'text-gray-400' %> flex items-center gap-1 font-medium">
            <%= @low_stock_count > 0 ? 'Action required soon' : 'All stocks optimal' %>
          </p>
        </div>

      </div>

      <!-- Tables Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Recent Transactions -->
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
          <h2 class="text-lg font-bold text-gray-900 mb-4">Recent Transactions</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-xs font-semibold text-gray-500 border-b border-gray-100">
                  <th scope="col" class="pb-3 w-12">S/N</th>
                  <th scope="col" class="pb-3">Product</th>
                  <th scope="col" class="pb-3">Amount</th>
                  <th scope="col" class="pb-3 text-right">Status</th>
                </tr>
              </thead>
              <tbody class="text-sm">
                <% @recent_transactions.each_with_index do |tx, index| %>
                  <tr class="border-b border-gray-50 last:border-0 relative">
                    <td class="py-4 text-gray-500 font-medium">0<%= index + 1 %></td>
                    <td class="py-4 text-gray-900 font-medium"><%= tx.slot&.product&.name || 'Unknown product' %></td>
                    <td class="py-4 text-gray-500">Rp <%= tx.amount.to_i %></td>
                    <td class="py-4 text-right">
                      <% if tx.settled? %>
                        <span class="text-green-500 font-medium">Settled</span>
                      <% else %>
                        <span class="text-orange-400 font-medium capitalize"><%= tx.status %></span>
                      <% end %>
                      <!-- UI decoration line -->
                      <div class="absolute right-[-24px] top-4 h-6 w-1 rounded-l <%= tx.settled? ? 'bg-green-500' : 'bg-orange-400' %>"></div>
                    </td>
                  </tr>
                <% end %>
                <% if @recent_transactions.empty? %>
                  <tr><td colspan="4" class="py-4 text-center text-gray-400 text-xs">No transactions yet.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Machine Status List -->
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
          <h2 class="text-lg font-bold text-gray-900 mb-4">Machine List</h2>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="text-xs font-semibold text-gray-500 border-b border-gray-100">
                  <th scope="col" class="pb-3 w-12">S/N</th>
                  <th scope="col" class="pb-3">Location</th>
                  <th scope="col" class="pb-3">ID</th>
                  <th scope="col" class="pb-3 text-right">Status</th>
                </tr>
              </thead>
              <tbody class="text-sm">
                <% @machines_list.each_with_index do |machine, index| %>
                  <tr class="border-b border-gray-50 last:border-0 relative">
                    <td class="py-4 text-gray-500 font-medium">0<%= index + 1 %></td>
                    <td class="py-4 text-gray-900 font-medium"><%= machine.location_name %></td>
                    <td class="py-4 text-gray-500 font-mono text-xs"><%= machine.uuid.split('-').first %></td>
                    <td class="py-4 text-right">
                      <% if machine.status == 'active' %>
                        <span class="text-blue-500 font-medium">Active</span>
                      <% else %>
                        <span class="text-gray-400 font-medium capitalize"><%= machine.status %></span>
                      <% end %>
                      <!-- UI decoration line -->
                      <div class="absolute right-[-24px] top-4 h-6 w-1 rounded-l <%= machine.status == 'active' ? 'bg-blue-500' : 'bg-gray-400' %>"></div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </div>

  </main>
</div>