<!DOCTYPE html>
<html>
  <head>
    <title>Vendora ERP</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0F2A3D">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Ini adalah baris penting yang membuat CSS Tailwind bekerja -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="erp-body bg-[#f8f9fa] text-gray-900 antialiased font-sans">
    
    <% if user_signed_in? %>
      <a class="erp-skip-link" href="#main-content">Skip to content</a>
      <%= render "shared/mobile_navigation" %>
    <% end %>
    <%= render "shared/flash_messages" %>

    <!-- Konten Utama Aplikasi -->
    <%= yield %>
    
    <!-- Wadah untuk Modal Add/Edit -->
    <%= turbo_frame_tag "modal" %>
    
  </body>
</html>
