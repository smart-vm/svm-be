<!DOCTYPE html>
<html>
  <head>
    <title>Vendora ERP</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0F2A3D">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <!-- Ini adalah baris penting yang membuat CSS Tailwind bekerja -->
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#f8f9fa] text-gray-900 antialiased font-sans">
    
    <!-- Flash Messages Handler -->
    <% if notice.present? %>
      <% if notice == "Signed in successfully." %>
        <%= render partial: 'shared/success_modal', locals: { title: "Welcome Back!", message: "You have been authenticated successfully. Welcome to Vendora ERP." } %>
      <% else %>
        <%= render partial: 'shared/success_modal', locals: { title: "Success!", message: notice } %>
      <% end %>
    <% end %>

    <% if alert.present? %>
      <% if alert == "You are already signed in." %>
        <%= render partial: 'shared/info_modal', locals: { title: "Session Active", message: "You are already securely signed into the ERP network." } %>
      <% else %>
       
      <% end %>
    <% end %>

    <!-- Konten Utama Aplikasi -->
    <%= yield %>
    
    <!-- Wadah untuk Modal Add/Edit -->
    <%= turbo_frame_tag "modal" %>
    
  </body>
</html>